# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Football
API_FOOTBALL_KEY=your-api-football-key

# IA (plus tard)
GEMINI_API_KEY=your-gemini-key
MOCK_AI=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE_NC=Pacific/Noumea

# Notifications push (Web Push / VAPID)
# Générer une paire : node -e "console.log(require('web-push').generateVAPIDKeys())"
# ⚠️ NEXT_PUBLIC_VAPID_PUBLIC_KEY est injectée au BUILD côté client : sans elle,
#    aucun abonnement ne peut se créer (donc personne ne reçoit de notif).
#    À définir sur Vercel (Production + Preview) puis redéployer.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT_EMAIL=contact@canalcup.nc

# Secret partagé pour authentifier les cron Vercel (Bearer). Une chaîne aléatoire.
CRON_SECRET=your-cron-secret
