# === CANAL SPORTS — base principale (read/write) ===
# Organisation Supabase vjasdstjdszsekbwazbi. Seule base sur laquelle
# CANAL Sports écrit. Voir docs/supabase-architecture-p2.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === CANAL CUP — legacy, LECTURE SEULE ===
# Ne jamais utiliser ces variables dans une route applicative normale.
# Réservées aux scripts d'audit/import (lib/supabase/legacy.ts). Ne pas
# renseigner LEGACY_CANALCUP_SUPABASE_URL avec la même valeur que
# NEXT_PUBLIC_SUPABASE_URL — le process refuse de démarrer si c'est le cas
# (voir instrumentation.ts).
LEGACY_CANALCUP_SUPABASE_URL=https://your-legacy-project.supabase.co
LEGACY_CANALCUP_SUPABASE_ANON_KEY=your-legacy-anon-key
# Optionnel — uniquement si un script d'audit doit lire au-delà de la RLS.
# Jamais consommé par le code applicatif (lib/supabase/legacy.ts bloque
# de toute façon insert/update/upsert/delete/rpc/storage).
LEGACY_CANALCUP_SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Football — fournisseurs de données sportives (lib/providers/, voir
# docs/adr/0003-sport-provider-abstraction.md). Chaque clé est optionnelle :
# un provider sans clé configurée lève une erreur explicite à l'appel,
# jamais un fallback silencieux. Ne rien souscrire/payer sans validation
# explicite — le plan Free suffit pour le MVP (Décision A, 2026-09-25).
#
# Provider actif : football-data.org par défaut si absent (voir
# lib/providers/registry.ts). Ne changer que pour du debug ponctuel —
# api-football reste disponible mais son compte est actuellement suspendu.
# FOOTBALL_PROVIDER=football-data.org
API_FOOTBALL_KEY=your-api-football-key
FOOTBALL_DATA_ORG_API_KEY=your-football-data-org-key
# Optionnel, source complémentaire non prioritaire (logos/métadonnées) :
THESPORTSDB_API_KEY=your-thesportsdb-key

# IA (plus tard)
GEMINI_API_KEY=your-gemini-key
MOCK_AI=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE_NC=Pacific/Noumea

# Notifications push (Web Push / VAPID)
# Générer une paire : node -e "console.log(require('web-push').generateVAPIDKeys())"
# ⚠️ NEXT_PUBLIC_VAPID_PUBLIC_KEY est injectée au BUILD côté client : sans elle,
#    aucun abonnement ne peut se créer (donc personne ne reçoit de notif).
#    À définir sur Vercel (Production + Preview) puis redéployer.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT_EMAIL=contact@canalcup.nc

# Secret partagé pour authentifier les cron Vercel (Bearer). Une chaîne aléatoire.
CRON_SECRET=your-cron-secret
